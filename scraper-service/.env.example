CONCURRENCY=5
REQUEST_TIMEOUT=15
DELAY_SECONDS=1.0
DATABASE_PATH=/app/data/scraper.db
USER_AGENT=Mozilla/5.0 (compatible; LeadContactBot/1.0; +mailto:youremail@example.com)

# Shared-secret header the Node app must send (X-Scraper-Secret) since this
# service has no other authentication. Generate any long random string.
SCRAPER_API_SECRET=change-this-to-a-long-random-string
