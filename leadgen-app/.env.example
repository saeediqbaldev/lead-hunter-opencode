# Copy this file to .env and fill in your key
# Get a key at https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Enable "Places API (New)" on the project first, and enable billing
# (Google requires a card on file even to use the free monthly quota,
# but if you stay under the limits described in README.md you will not be charged)
GOOGLE_PLACES_API_KEY=your_key_here

# Port the server runs on
PORT=3000

# Daily lead cap (keeps you inside free API quota + keeps outreach volume sane)
DAILY_LEAD_CAP=100

# Session signing secret - set this to any long random string in production
# (Coolify: Environment Variables tab). If left unset, sessions still work
# but everyone gets logged out whenever the server restarts.
SESSION_SECRET=change-this-to-a-long-random-string

# The Contact Scraper is a SEPARATE service (see ../scraper-service) - these
# two vars point this app at it. Leave SCRAPER_SERVICE_URL as the Docker
# Compose service name (e.g. http://scraper:8000) if running via compose;
# use the actual internal URL if deploying on Coolify. SCRAPER_API_SECRET
# must match the same value set on the scraper service itself.
SCRAPER_SERVICE_URL=http://scraper:8000
SCRAPER_API_SECRET=change-this-to-a-long-random-string
