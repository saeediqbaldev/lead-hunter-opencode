# Used only if you run `docker compose up` locally with a .env file next to
# docker-compose.yml. On Coolify, set these same names under the resource's
# Environment Variables tab instead - this file is just a reference/local dev copy.

SESSION_SECRET=change-this-to-a-long-random-string
SCRAPER_API_SECRET=change-this-to-a-different-long-random-string
GOOGLE_PLACES_API_KEY=

# --- OpenCode agent server (optional 4th AI provider) ---
# If these are empty, OpenCode is skipped and the app works exactly as
# before (Groq -> Gemini -> DeepSeek fallback chain).
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Shared secret for HTTP basic auth between leadgen-app and the opencode
# server. Must be set on BOTH the leadgen-app and opencode services (the
# compose file wires it to both). Leave empty only if you're on a trusted
# private network - then the opencode API has no auth.
OPENCODE_SERVER_PASSWORD=change-this-to-another-long-random-string

# Which model the opencode server should run for app requests, as
# provider/model. Defaults to groq/openai/gpt-oss-120b.
OPENCODE_MODEL=groq/openai/gpt-oss-120b
